<div class="fixed bottom-5 right-6 z-[10000]">
  <div id="contactAssistantOptions" class="contact-assistant-actions" aria-label="Contact options" aria-hidden="true">
    <a href="https://wa.me/918229056036?text=Hello%20SecureAegix%2C%20I%20need%20assistance." target="_blank" rel="noopener noreferrer" aria-label="Chat on WhatsApp" title="WhatsApp" class="contact-assistant-action contact-assistant-action--whatsapp">
      <i class="fab fa-whatsapp text-xl" aria-hidden="true"></i>
    </a>
    <a href="tel:+918229056036" aria-label="Call SecureAegix" title="Call us" class="contact-assistant-action contact-assistant-action--call">
      <i class="fas fa-phone text-lg" aria-hidden="true"></i>
    </a>
    <button type="button" data-assistant-action="chat" aria-label="Chat with SecureAegix" title="Chat with us" class="contact-assistant-action contact-assistant-action--chat">
      <i class="fas fa-comments text-lg" aria-hidden="true"></i>
    </button>
  </div>

  <section id="contactChatPanel" class="absolute bottom-16 right-0 z-[10001] hidden h-[min(70vh,34rem)] max-h-[calc(100dvh-6rem)] w-[min(24rem,calc(100vw-2rem))] flex flex-col overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-2xl dark:border-gray-700 dark:bg-gray-900" role="dialog" aria-modal="false" aria-labelledby="contactChatTitle" aria-hidden="true">
    <header class="flex items-center justify-between bg-gradient-to-r from-blue-700 to-cyan-600 px-4 py-3 text-white">
      <div>
        <h2 id="contactChatTitle" class="font-bold">SecureAegix Assistant</h2>
        <p class="text-xs text-blue-100">Courses, articles, and support</p>
      </div>
      <button id="contactChatClose" type="button" aria-label="Close chat" class="flex h-8 w-8 items-center justify-center rounded-lg hover:bg-white/15 focus-visible:outline focus-visible:outline-2 focus-visible:outline-white">
        <i class="fas fa-xmark" aria-hidden="true"></i>
      </button>
    </header>

    <div class="relative min-h-0 flex-1 bg-white dark:bg-gray-900">
      <div id="contactChatMessages" class="flex h-full flex-col gap-3 overflow-y-auto p-4 pb-16 dark:bg-gray-900" aria-live="polite">
        <p class="mr-auto max-w-[90%] rounded-2xl rounded-bl-sm bg-gray-100 px-3 py-2 text-sm text-gray-800 dark:bg-gray-700 dark:text-gray-100">Hi! Ask me about our courses, cybersecurity articles, services, or how to contact the team.</p>
        <div class="flex flex-wrap gap-2">
          <button type="button" data-chat-prompt="Which cybersecurity courses do you offer?" class="rounded-full border border-cyan-700/30 px-3 py-1.5 text-xs text-cyan-800 hover:bg-cyan-50 dark:text-cyan-200 dark:hover:bg-cyan-900/30">Find a course</button>
          <button type="button" data-chat-prompt="Show me cybersecurity blogs and learning resources." class="rounded-full border border-cyan-700/30 px-3 py-1.5 text-xs text-cyan-800 hover:bg-cyan-50 dark:text-cyan-200 dark:hover:bg-cyan-900/30">Find a blog</button>
          <button type="button" data-chat-prompt="How can I contact SecureAegix?" class="rounded-full border border-cyan-700/30 px-3 py-1.5 text-xs text-cyan-800 hover:bg-cyan-50 dark:text-cyan-200 dark:hover:bg-cyan-900/30">Contact details</button>
        </div>
      </div>
      <div id="contactChatTyping" class="absolute bottom-3 left-4 z-10 hidden items-center gap-2 rounded-2xl rounded-bl-sm bg-gray-100 px-3 py-2 text-xs text-gray-600 shadow-md dark:bg-gray-700 dark:text-gray-300" role="status" aria-live="polite">
        <span class="flex items-center gap-1" aria-label="Assistant is typing">
          <span class="contact-chat-typing-dot"></span>
          <span class="contact-chat-typing-dot"></span>
          <span class="contact-chat-typing-dot"></span>
        </span>
        <span>SecureAegix is typing</span>
      </div>
    </div>

    <form id="contactChatForm" class="flex gap-2 border-t border-gray-200 bg-white p-3 dark:border-gray-700 dark:bg-gray-900">
      <label class="sr-only" for="contactChatInput">Your message</label>
      <input id="contactChatInput" type="text" maxlength="500" autocomplete="off" placeholder="Type your question..." class="min-w-0 flex-1 rounded-xl border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 outline-none focus:border-cyan-600 focus:ring-2 focus:ring-cyan-600/20 dark:border-gray-600 dark:bg-gray-800 dark:text-white">
      <button id="contactChatSend" type="submit" aria-label="Send message" class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-cyan-700 text-white transition hover:bg-cyan-800 disabled:cursor-wait disabled:opacity-60 dark:bg-cyan-500 dark:text-gray-950">
        <i class="fas fa-paper-plane" aria-hidden="true"></i>
      </button>
    </form>
    <p id="contactChatStatus" class="px-4 pb-2 text-xs text-gray-500 dark:text-gray-400" role="status" aria-live="polite"></p>
  </section>

  <button id="contactAssistantToggle" type="button" aria-label="Open contact options" aria-expanded="false" aria-controls="contactAssistantOptions" class="relative z-10 flex h-14 w-14 items-center justify-center rounded-full bg-gradient-to-r from-blue-600 to-cyan-600 text-white shadow-lg transition hover:scale-105 hover:shadow-xl focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-600">
    <i id="contactAssistantToggleIcon" class="fas fa-headset text-xl transition-transform duration-200" aria-hidden="true"></i>
  </button>
</div>
