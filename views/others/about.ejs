<script>
// Scroll reveal
const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => { if(e.isIntersecting){ e.target.classList.add('visible'); observer.unobserve(e.target); } });
}, { threshold: 0.1 });
document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

// Counter animation
const counterObserver = new IntersectionObserver((entries) => {
    entries.forEach(e => {
        if(e.isIntersecting) {
            const el = e.target;
            const target = parseInt(el.dataset.target);
            const suffix = el.dataset.suffix || '';
            let current = 0;
            const step = Math.ceil(target/60);
            const timer = setInterval(() => {
                current = Math.min(current+step, target);
                el.textContent = current + suffix;
                if(current>=target) clearInterval(timer);
            }, 25);
            counterObserver.unobserve(el);
        }
    });
}, { threshold: 0.5 });
document.querySelectorAll('.stat-number[data-target]').forEach(el => counterObserver.observe(el));

// FAQ accordion
function toggleFaq(btn) {
    const body = btn.nextElementSibling;
    const icon = btn.querySelector('.faq-icon');
    const isOpen = body.classList.contains('open');
    document.querySelectorAll('.faq-body.open').forEach(b => b.classList.remove('open'));
    document.querySelectorAll('.faq-icon.open').forEach(i => i.classList.remove('open'));
    if(!isOpen){ body.classList.add('open'); icon.classList.add('open'); }
}

// ===================== TEAM SCROLL CONTROLS =====================
(function () {
    const scroller  = document.querySelector('.team-scroll-row');
    if (!scroller) return;

    const leftBtn   = document.getElementById('teamScrollLeft');
    const rightBtn  = document.getElementById('teamScrollRight');
    const dotsWrap  = document.getElementById('teamScrollDots');
    const hint      = document.getElementById('teamSwipeHint');
    const cards     = scroller.querySelectorAll('.team-card-wrapper');
    const GAP       = 24; // matches gap-6 (1.5rem)

    // Build dots
    cards.forEach((_, i) => {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'team-dot w-2 h-2 rounded-full bg-gray-300 dark:bg-gray-600 transition-all duration-300';
        dot.setAttribute('aria-label', `Go to team member ${i + 1}`);
        dot.addEventListener('click', () => {
            cards[i].scrollIntoView({ behavior: 'smooth', inline: 'start', block: 'nearest' });
        });
        dotsWrap.appendChild(dot);
    });

    function scrollByCard(dir) {
        const card = cards[0];
        if (!card) return;
        const amount = card.offsetWidth + GAP;
        scroller.scrollBy({ left: dir * amount, behavior: 'smooth' });
    }

    leftBtn.addEventListener('click',  () => scrollByCard(-1));
    rightBtn.addEventListener('click', () => scrollByCard(1));

    function updateUI() {
        const { scrollLeft, scrollWidth, clientWidth } = scroller;

        leftBtn.disabled  = scrollLeft <= 2;
        rightBtn.disabled = scrollLeft + clientWidth >= scrollWidth - 2;

        const cardW = (cards[0]?.offsetWidth || 0) + GAP;
        const activeIndex = Math.round(scrollLeft / cardW);

        dotsWrap.querySelectorAll('.team-dot').forEach((d, i) => {
            const active = i === activeIndex;
            d.classList.toggle('bg-blue-600',   active);
            d.classList.toggle('dark:bg-blue-400', active);
            d.classList.toggle('scale-125',     active);
            d.classList.toggle('bg-gray-300',   !active);
            d.classList.toggle('dark:bg-gray-600', !active);
        });
    }

    scroller.addEventListener('scroll', updateUI, { passive: true });
    window.addEventListener('resize', updateUI);
    updateUI();

    // Hide swipe hint after first interaction (mobile)
    if (hint) {
        const hideHint = () => { hint.style.display = 'none'; };
        scroller.addEventListener('scroll', hideHint, { once: true, passive: true });
        scroller.addEventListener('touchstart', hideHint, { once: true, passive: true });
    }
})();
</script>