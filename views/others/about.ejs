<!-- ===================== STYLES (only what Tailwind can't do) ===================== -->
<style>
    .text-gradient {
        background: linear-gradient(135deg, #2563eb, #06b6d4);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    /* Scroll reveal */
    .reveal { opacity: 0; transform: translateY(28px); transition: opacity 0.6s ease, transform 0.6s ease; }
    .reveal.visible { opacity: 1; transform: translateY(0); }
    .reveal-delay-1 { transition-delay: 0.1s; }
    .reveal-delay-2 { transition-delay: 0.2s; }
    .reveal-delay-3 { transition-delay: 0.3s; }

    /* Team flip card (desktop only) */
    .team-card-wrapper { perspective: 1200px; height: 390px; }
    .team-card-inner {
        position: relative; width: 100%; height: 100%;
        transition: transform 0.7s cubic-bezier(0.4,0,0.2,1);
        transform-style: preserve-3d;
    }
    @media (min-width: 768px) {
        .team-card-wrapper:hover .team-card-inner,
        .team-card-wrapper:focus-within .team-card-inner { transform: rotateY(180deg); }
    }

    .team-card-front, .team-card-back {
        position: absolute; width: 100%; height: 100%;
        -webkit-backface-visibility: hidden; backface-visibility: hidden;
        border-radius: 1.5rem; overflow: hidden;
        box-shadow: 0 15px 35px -8px rgba(0,0,0,0.1), 0 0 0 1px rgba(0,0,0,0.02);
        transition: box-shadow 0.3s ease;
    }
    @media (min-width: 768px) {
        .team-card-wrapper:hover .team-card-front { box-shadow: 0 25px 45px -12px rgba(0,0,0,0.2); }
    }

    .team-card-front .avatar-ring { transition: box-shadow 0.3s ease; }
    @media (min-width: 768px) {
        .team-card-wrapper:hover .avatar-ring { box-shadow: 0 0 0 6px rgba(59,130,246,0.2), 0 0 25px rgba(59,130,246,0.15); }
    }

    .team-card-back {
        transform: rotateY(180deg);
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        text-align: center; padding: 1.5rem;
    }

    /* On mobile, disable 3D flip; only show mobile card */
    @media (max-width: 767px) {
        .team-card-wrapper {
            perspective: none;
            height: auto !important;
            width: 280px !important;
        }
        .team-card-inner { transform: none !important; transition: none !important; }
        .team-card-front,
        .team-card-back { display: none !important; }
    }

    /* Team scroll row — snap + hidden scrollbar */
    .team-scroll-row {
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }
    .team-scroll-row::-webkit-scrollbar { display: none; width: 0; height: 0; }
    .team-scroll-row::-webkit-scrollbar-corner { display: none; background: transparent; }
    .team-scroll-row > * { scroll-snap-align: start; flex-shrink: 0; }

    /* Marquee */
    @keyframes marquee { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
    .marquee-track { display: flex; width: max-content; animation: marquee 30s linear infinite; }
    .marquee-track:hover { animation-play-state: paused; }

    /* Cert badge */
    .cert-badge { display: inline-flex; align-items: center; gap: 3px; font-size: 0.7rem; font-weight: 600; padding: 3px 10px; border-radius: 9999px; white-space: nowrap; }

    /* FAQ */
    .faq-body { max-height: 0; overflow: hidden; transition: max-height 0.4s ease, padding 0.3s ease; }
    .faq-body.open { max-height: 400px; padding-top: 0.75rem; padding-bottom: 0.75rem; }
    .faq-icon { transition: transform 0.3s ease; }
    .faq-icon.open { transform: rotate(45deg); }

    /* Float */
    @keyframes floatY { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-12px); } }
    .animate-float { animation: floatY 5s ease-in-out infinite; }

    /* Swipe hint nudge */
    @keyframes swipeNudge {
        0%, 100% { transform: translateX(0); }
        50%      { transform: translateX(-8px); }
    }
    .swipe-nudge { animation: swipeNudge 1.6s ease-in-out infinite; }

    @media (prefers-reduced-motion: reduce) {
        .reveal, .team-card-inner, .marquee-track, .animate-float, .swipe-nudge { transition: none !important; animation: none !important; }
    }
</style>

