<!-- Newsletter Subscription Script -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    const newsletterForm = document.getElementById('newsletterForm');
    const emailInput = document.getElementById('newsletterEmail');
    const subscribeBtn = document.getElementById('subscribeBtn');
    const messageContainer = document.getElementById('subscriptionMessage');
    
    if (newsletterForm) {
        newsletterForm.addEventListener('submit', async function(e) {
            e.preventDefault();
            const email = emailInput.value.trim();
            messageContainer.classList.add('hidden');
            messageContainer.innerHTML = '';
            
            if (!email) { showMessage('Please enter your email address', 'error'); return; }
            if (!isValidEmail(email)) { showMessage('Please enter a valid email address', 'error'); return; }
            
            subscribeBtn.disabled = true;
            const originalText = subscribeBtn.innerHTML;
            subscribeBtn.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i> Subscribing...';
            
            try {
                const captchaToken = newsletterForm.querySelector('[name="captchaToken"]')?.value;
                if (!captchaToken) {
                    throw new Error('Security verification is incomplete. Please submit the form again.');
                }

                let response;
                let data;
                for (let attempt = 0; attempt < 2; attempt += 1) {
                    const csrfToken = window.refreshSecureCsrfToken && attempt === 0
                        ? await window.refreshSecureCsrfToken()
                        : document.querySelector('meta[name="csrf-token"]')?.content;
                    response = await fetch('/subscribe', {
                        method: 'POST',
                        headers: {
                            'Accept': 'application/json',
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            email: email,
                            captchaToken,
                            _csrf: csrfToken
                        })
                    });

                    try {
                        data = await response.json();
                    } catch {
                        throw new Error(
                            response.ok
                                ? 'The server returned an unexpected response. Please try again.'
                                : `Subscription failed (HTTP ${response.status}). Please try again.`
                        );
                    }

                    if (
                        response.status === 403 &&
                        data.code === 'CSRF_TOKEN_INVALID' &&
                        attempt === 0 &&
                        window.refreshSecureCsrfToken
                    ) {
                        await window.refreshSecureCsrfToken();
                        continue;
                    }
                    break;
                }

                if (response.ok && data.success) {
                    showMessage(data.message || 'Successfully subscribed to newsletter!', 'success');
                    emailInput.value = '';
                    setTimeout(() => {
                        const msgDiv = document.getElementById('subscriptionMessage');
                        if (msgDiv && !msgDiv.classList.contains('hidden')) fadeOut(msgDiv);
                    }, 5000);
                } else {
                    showMessage(data.message || 'Subscription failed. Please try again.', 'error');
                }
            } catch (error) {
                showMessage(
                    error.message || 'Network error. Please check your connection and try again.',
                    'error'
                );
            } finally {
                subscribeBtn.disabled = false;
                subscribeBtn.innerHTML = originalText;
            }
        });
    }
    
    function isValidEmail(email) { return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email); }
    
    function showMessage(message, type) {
        messageContainer.classList.remove('hidden');
        const alert = document.createElement('div');
        alert.className = `subscription-alert subscription-${type} animate-slide-in`;
        const icon = document.createElement('i');
        icon.className = `fas ${type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle'} mr-2`;
        icon.setAttribute('aria-hidden', 'true');
        const text = document.createElement('span');
        text.textContent = message;
        alert.replaceChildren(icon, text);
        messageContainer.replaceChildren(alert);
        if (type === 'error') {
            setTimeout(() => {
                const msgDiv = document.getElementById('subscriptionMessage');
                if (msgDiv && !msgDiv.classList.contains('hidden')) fadeOut(msgDiv);
            }, 5000);
        }
    }
    
    function fadeOut(element) {
        element.style.transition = 'opacity 0.5s ease';
        element.style.opacity = '0';
        setTimeout(() => {
            element.classList.add('hidden');
            element.style.opacity = '';
        }, 500);
    }
});

const subscriptionStyles = document.createElement('style');
subscriptionStyles.textContent = `
    .subscription-alert { padding: 10px 16px; border-radius: 8px; font-size: 14px; font-weight: 500; text-align: center; animation: slideIn 0.3s ease-out; }
    .subscription-success { background-color: rgba(34, 197, 94, 0.2); border: 1px solid rgba(34, 197, 94, 0.4); color: #ffffff; }
    .subscription-error { background-color: rgba(239, 68, 68, 0.2); border: 1px solid rgba(239, 68, 68, 0.4); color: #ffffff; }
    @keyframes slideIn { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }
`;
document.head.appendChild(subscriptionStyles);
</script>

<!-- Counter Animation Script -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  const counters = document.querySelectorAll('.counter');
  const animateCounter = (counter) => {
    const target = parseInt(counter.getAttribute('data-target'));
    let count = 0;
    const increment = target / 60;
    const updateCount = () => {
      count += increment;
      if (count < target) {
        counter.innerText = Math.ceil(count);
        setTimeout(updateCount, 20);
      } else {
        counter.innerText = target + '+';
      }
    };
    updateCount();
  };
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        animateCounter(entry.target);
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.5 });
  counters.forEach(counter => observer.observe(counter));
});
</script>

<!-- Legacy Community Milestones script (currently no matching markup — harmless) -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  const message = document.querySelector('[data-community-message]');
  const label   = document.querySelector('[data-community-label]');
  const icon    = document.querySelector('[data-community-icon]');
  const container = document.querySelector('[data-community-events]');
  if (!message || !label || !icon || !container) return;
  const events = Array.from(container.children);
  if (!events.length) return;

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let idx = 0, timer;
  const enrollIcon = 'fa-user-plus', doneIcon = 'fa-award';

  function show() {
    const ev = events[idx];
    const text = `${ev.dataset.member} ${ev.dataset.action} ${ev.dataset.course}`;
    const done = ev.dataset.kind === 'completion';
    label.textContent = done ? 'Course completed' : 'New enrollment';
    icon.classList.toggle(enrollIcon, !done);
    icon.classList.toggle(doneIcon, done);

    if (reduced) { message.textContent = text; return; }
    let i = 0, deleting = false;
    (function type() {
      if (!deleting) {
        i++; message.textContent = text.slice(0, i);
        if (i === text.length) {
          timer = setTimeout(() => { deleting = true; type(); }, 1900);
          return;
        }
      } else {
        i--; message.textContent = text.slice(0, i);
        if (i === 0) { idx = (idx + 1) % events.length; timer = setTimeout(show, 350); return; }
      }
      timer = setTimeout(type, deleting ? 24 : 38);
    })();
  }
  show();
  window.addEventListener('pagehide', () => clearTimeout(timer), { once: true });
});
</script>

<!-- Scroll-reveal observer -->
<script>
(function() {
  const revealEls = document.querySelectorAll('[data-reveal]');
  if (!revealEls.length) return;

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduceMotion || !('IntersectionObserver' in window)) {
    revealEls.forEach(el => el.classList.add('is-visible'));
    return;
  }

  const io = new IntersectionObserver((entries, observer) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      }
    });
  }, {
    threshold: 0.15,
    rootMargin: '0px 0px -60px 0px'
  });

  revealEls.forEach(el => io.observe(el));
})();
</script>

