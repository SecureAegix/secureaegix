<script>
document.addEventListener('DOMContentLoaded', function() {
  const rangeDemo = document.getElementById('range-demo');
  if (!rangeDemo) return;

  const scenarios = {
    web: {
      title: 'Investigate a suspicious web request',
      description: 'Review a simulated application event, identify an unsafe request pattern, and recommend a defensive fix.',
      events: ['09:41:02  GET /account?id=1042  ·  normal', '09:41:08  GET /account?id=1043  ·  review access controls', '09:41:15  Analyst note: validate authorization server-side']
    },
    soc: {
      title: 'Triage an unusual sign-in',
      description: 'Correlate a sample identity alert with sign-in context, assess its severity, and document a safe response.',
      events: ['10:17:24  Identity alert  ·  impossible travel', '10:18:03  MFA challenge  ·  denied', '10:19:11  Analyst action: contain session, verify user']
    },
    cloud: {
      title: 'Harden a cloud storage policy',
      description: 'Inspect a fictional cloud configuration, identify an exposure risk, and prioritize a least-privilege fix.',
      events: ['11:02:06  Storage policy  ·  public access detected', '11:02:31  Data classification  ·  internal', '11:03:10  Analyst action: restrict access, review audit log']
    }
  };
  const title = rangeDemo.querySelector('[data-range-title]');
  const description = rangeDemo.querySelector('[data-range-description]');
  const feed = rangeDemo.querySelector('[data-range-feed]');

  rangeDemo.querySelectorAll('[data-range-scenario]').forEach(function(button) {
    button.addEventListener('click', function() {
      const scenario = scenarios[button.dataset.rangeScenario];
      if (!scenario) return;

      rangeDemo.querySelectorAll('[data-range-scenario]').forEach(function(tab) {
        const isActive = tab === button;
        tab.setAttribute('aria-pressed', String(isActive));
        tab.classList.toggle('border-cyan-400/40', isActive);
        tab.classList.toggle('bg-cyan-400/10', isActive);
        tab.classList.toggle('bg-white/5', !isActive);
        tab.classList.toggle('border-transparent', !isActive);
      });

      title.textContent = scenario.title;
      description.textContent = scenario.description;
      feed.replaceChildren();
      scenario.events.forEach(function(eventText) {
        const event = document.createElement('div');
        event.className = 'text-gray-700 dark:text-gray-300';
        const marker = document.createElement('span');
        marker.className = 'mr-2 text-cyan-600 dark:text-cyan-400';
        marker.textContent = '›';
        event.append(marker, document.createTextNode(eventText));
        feed.appendChild(event);
      });
    });
  });
  rangeDemo.querySelector('[data-range-scenario="web"]').click();
});
</script>

