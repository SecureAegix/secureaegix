<% layout("/layouts/boilerplate") %>

<!-- Custom Styles for Premium Effects -->
<style>
  /* Premium Animations */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }
  
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  
  @keyframes pulse-glow {
    0%, 100% { opacity: 0.3; }
    50% { opacity: 0.6; }
  }
  
  @keyframes slideInLeft {
    from { opacity: 0; transform: translateX(-50px); }
    to { opacity: 1; transform: translateX(0); }
  }
  
  @keyframes slideInRight {
    from { opacity: 0; transform: translateX(50px); }
    to { opacity: 1; transform: translateX(0); }
  }
  
  @keyframes blink {
    50% { opacity: 0; }
  }
  
  .fade-up { animation: fadeUp 0.7s ease forwards; }
  .fade-in { animation: fadeIn 0.5s ease forwards; }
  .slide-left { animation: slideInLeft 0.6s ease forwards; }
  .slide-right { animation: slideInRight 0.6s ease forwards; }
  .delay-1 { animation-delay: 0.1s; opacity: 0; }
  .delay-2 { animation-delay: 0.2s; opacity: 0; }
  .delay-3 { animation-delay: 0.35s; opacity: 0; }
  .delay-4 { animation-delay: 0.5s; opacity: 0; }
  
  /* Glass Effect */
  .glass-effect {
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  
  .dark .glass-effect {
    background: rgba(17, 24, 39, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.05);
  }
  
  /* Hover Lift Effect */
  .hover-lift {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .hover-lift:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 40px -12px rgba(0, 0, 0, 0.3);
  }
  
  /* Terminal Animation */
  .t-blink { animation: blink 1s step-end infinite; }
  
  /* Ticker Animation */
  @keyframes ticker {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  
  .ticker-track {
    animation: ticker 25s linear infinite;
  }
  
  .ticker-wrap:hover .ticker-track {
    animation-play-state: paused;
  }
  
  /* Progress Bar */
  .progress-bar {
    height: 4px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    overflow: hidden;
  }
  
  .progress-fill {
    height: 100%;
    background: linear-gradient(90deg, #3b82f6, #06b6d4);
    border-radius: 4px;
    transition: width 1s ease;
  }
  
  /* Card Border Glow */
  .card-glow {
    position: relative;
    overflow: hidden;
  }
  
  .card-glow::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(59, 130, 246, 0.1), transparent);
    transition: left 0.5s;
  }
  
  .card-glow:hover::before {
    left: 100%;
  }
  
  /* Gradient Text */
  .text-gradient {
    background: linear-gradient(135deg, #3b82f6, #06b6d4);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  
  /* Floating Animation */
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }
  
  .animate-float {
    animation: float 6s ease-in-out infinite;
  }
  
  /* Badge Pulse */
  .badge-dot {
    width: 8px;
    height: 8px;
    background: #10b981;
    border-radius: 50%;
    animation: pulse-dot 2s infinite;
  }
  
  @keyframes pulse-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.8); }
  }

  /* Image collage helper (hero) */
  .img-tile {
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.4s ease;
  }
  .img-tile:hover {
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 18px 40px -12px rgba(0,0,0,0.45);
  }

  /* ============ SCROLL-REVEAL SYSTEM ============ */
  [data-reveal] {
    opacity: 0;
    will-change: opacity, transform;
    transition: opacity 0.9s cubic-bezier(0.22, 1, 0.36, 1),
                transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  }
  [data-reveal="up"]      { transform: translateY(40px); }
  [data-reveal="left"]    { transform: translateX(-60px); }
  [data-reveal="right"]   { transform: translateX(60px); }
  [data-reveal="scale"]   { transform: scale(0.9); }
  [data-reveal="diamond"] {
    transform: translate(-70px, -70px) rotate(-18deg) scale(0.75);
    transition-duration: 1.1s;
    transition-timing-function: cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  [data-reveal].is-visible {
    opacity: 1;
    transform: none;
  }

  /* ============ RHOMBUS → RECTANGLE ROLLING REVEAL ============ */
  [data-reveal="rhombus-roll"] {
    opacity: 0;
    transform: rotate(-22deg) scale(0.82);
    transform-origin: bottom right;
    transition: opacity 0.9s ease var(--rd, 0s),
                transform 1.4s cubic-bezier(0.22, 1, 0.36, 1) var(--rd, 0s);
  }
  [data-reveal="rhombus-roll"] .rhombus-to-rect {
    clip-path: polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%);
    transition: clip-path 1.4s cubic-bezier(0.22, 1, 0.36, 1) var(--rd, 0s);
    will-change: clip-path;
  }
  [data-reveal="rhombus-roll"].is-visible {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }
  [data-reveal="rhombus-roll"].is-visible .rhombus-to-rect {
    clip-path: polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%);
  }
  .delay-rhombus { --rd: 0.15s; }

  .rhombus-clip {
    clip-path: polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%);
  }

  .range-preview-image-copy {
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.95), 0 0 12px rgba(0, 0, 0, 0.7);
  }

  @media (max-width: 767px) {
    [data-reveal="rhombus-roll"] {
      transform: none;
      transform-origin: center;
    }

    [data-reveal="rhombus-roll"].is-visible {
      transform: none;
    }

    [data-reveal="rhombus-roll"] .rhombus-to-rect,
    [data-reveal="rhombus-roll"].is-visible .rhombus-to-rect {
      clip-path: none;
      transition: none;
    }
  }

  /* ============ RECENT LEARNER ACTIVITY TOAST ============ */
  .activity-toast {
    position: fixed;
    left: 1.5rem;
    bottom: 1.5rem;
    z-index: 80;
    width: 340px;
    max-width: calc(100vw - 2rem);
    opacity: 0;
    transform: translateX(-120%);
    transition: opacity 0.5s ease, transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
  }
  .activity-toast.is-visible {
    opacity: 1;
    transform: translateX(0);
    pointer-events: auto;
  }
  .activity-toast.is-dismissed {
    display: none !important;
  }
  @media (max-width: 640px) {
    .activity-toast {
      left: 0.75rem;
      right: 0.75rem;
      bottom: 0.75rem;
      width: auto;
      max-width: none;
    }
  }

  @keyframes shimmer {
    0%   { background-position: -200% 0; }
    100% { background-position:  200% 0; }
  }
  .animate-shimmer {
    background-size: 200% 100%;
    animation: shimmer 3s linear infinite;
  }

  /* Accessibility: reduce motion */
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
    }
    [data-reveal] { opacity: 1 !important; transform: none !important; }
    [data-reveal="rhombus-roll"] .rhombus-to-rect { clip-path: none !important; }
  }
</style>

