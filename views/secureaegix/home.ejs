<!-- RECENT LEARNER ACTIVITY FEED                                 -->
<!-- ============================================================ -->
<script>
(function() {
  document.addEventListener('DOMContentLoaded', function() {
    const toast   = document.getElementById('activity-toast');
    const textEl  = document.getElementById('activity-text');
    const avatarEl = document.getElementById('activity-avatar');
    const badgeEl  = document.getElementById('activity-badge');
    const iconEl   = document.getElementById('activity-icon');
    const timeEl   = document.getElementById('activity-time');
    const closeBtn = document.getElementById('activity-toast-close');

    if (!toast || !textEl) return;

    const activities = <%- JSON.stringify(learnerActivities || []).replace(/</g, "\\u003c") %>;

    const iconMap = {
      signup:  'fa-user-plus',
      review: 'fa-star',
      welcome: 'fa-shield-halved'
    };
    const colorMap = {
      signup:  'from-blue-500 to-cyan-500',
      review: 'from-amber-500 to-orange-500',
      welcome: 'from-emerald-500 to-teal-500'
    };

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let timer = null;
    let isDismissed = false;
    let lastMessage = '';
    const historyKey = 'secureaegix.activityToast.history.v2';
    const historyWindowMs = 20 * 60 * 1000;
    let shownActivities = [];

    try {
      const savedHistory = JSON.parse(sessionStorage.getItem(historyKey) || '[]');
      if (Array.isArray(savedHistory)) {
        shownActivities = savedHistory.filter(entry =>
          entry &&
          typeof entry.id === 'string' &&
          Number.isFinite(entry.shownAt) &&
          Date.now() - entry.shownAt < historyWindowMs
        );
      }
    } catch (error) {
      console.error('Unable to read learner activity history:', error);
    }

    function saveHistory() {
      try {
        sessionStorage.setItem(historyKey, JSON.stringify(shownActivities));
      } catch (error) {
        console.error('Unable to save learner activity history:', error);
      }
    }

    function activityId(activity) {
      return activity.id;
    }

    function renderMessage(text) {
      const cursor = document.createElement('span');
      cursor.className = 't-blink text-cyan-600 dark:text-cyan-400 ml-0.5';
      cursor.textContent = '_';
      textEl.replaceChildren(document.createTextNode(text), cursor);
    }

    function setActivity(activity) {
      avatarEl.textContent = (activity.name || 'L').trim().charAt(0).toUpperCase();
      iconEl.className = 'fas ' + iconMap[activity.type] + ' text-[9px]';
      badgeEl.className = 'absolute -bottom-1 -right-1 flex h-5 w-5 items-center justify-center rounded-full bg-gradient-to-br ' +
        colorMap[activity.type] + ' text-white shadow-md';
      const ageMs = Math.max(0, Date.now() - new Date(activity.timestamp).getTime());
      const ageMinutes = Math.floor(ageMs / 60000);
      timeEl.textContent = ageMinutes < 1 ? 'Just now'
        : ageMinutes < 60 ? ageMinutes + 'm ago'
        : ageMinutes < 1440 ? Math.floor(ageMinutes / 60) + 'h ago'
        : Math.floor(ageMinutes / 1440) + 'd ago';
      if (activity.type === 'welcome') timeEl.textContent = 'Community message';
    }

    function typeMessage(fullText, onDone) {
      if (reduceMotion) {
        renderMessage(fullText);
        timer = setTimeout(onDone, 10000);
        return;
      }
      let i = 0;
      function step() {
        if (isDismissed) return;
        i++;
        renderMessage(fullText.slice(0, i));
        if (i < fullText.length) {
          const ch = fullText[i - 1];
          const delay = (ch === ' ') ? 145
                      : (ch === ',' || ch === '.' || ch === '!' || ch === '?') ? 260
                      : 85;
          timer = setTimeout(step, delay);
        } else {
          timer = setTimeout(onDone, 10000);
        }
      }
      step();
    }

    function deleteMessage(fullText, onDone) {
      if (reduceMotion) { onDone(); return; }
      let i = fullText.length;
      function step() {
        if (isDismissed) return;
        i--;
        renderMessage(fullText.slice(0, i));
        if (i > 0) {
          timer = setTimeout(step, 45);
        } else {
          timer = setTimeout(onDone, 800);
        }
      }
      step();
    }

    function cycle() {
      if (isDismissed) return;
      const now = Date.now();
      shownActivities = shownActivities.filter(entry => now - entry.shownAt < historyWindowMs);
      const activity = activities.find(candidate =>
        !shownActivities.some(entry => entry.id === activityId(candidate))
      );

      if (!activity) {
        const nextAvailableAt = Math.min(...shownActivities
          .filter(entry => activities.some(candidate => activityId(candidate) === entry.id))
          .map(entry => entry.shownAt + historyWindowMs));
        if (!lastMessage) {
          setActivity({
            name: 'SecureAegix',
            type: 'welcome',
            timestamp: now
          });
          lastMessage = 'Community update: Explore hands-on cybersecurity learning paths with SecureAegix.';
        }
        renderMessage(lastMessage);
        timer = setTimeout(function() {
          deleteMessage(lastMessage, cycle);
        }, Math.max(1000, nextAvailableAt - now));
        return;
      }

      shownActivities.push({ id: activityId(activity), shownAt: now });
      saveHistory();
      const fullText = activity.name + ' ' + activity.action + ' ' + activity.target;
      lastMessage = fullText;

      setActivity(activity);
      typeMessage(fullText, function() {
        deleteMessage(fullText, function() {
          if (isDismissed) return;
          cycle();
        });
      });
    }

    let revealTimer;
    revealTimer = setTimeout(function() {
      if (isDismissed) return;
      toast.classList.add('is-visible');
      cycle();
    }, 2500);

    closeBtn.addEventListener('click', function() {
      isDismissed = true;
      clearTimeout(timer);
      clearTimeout(revealTimer);
      toast.classList.remove('is-visible');
      setTimeout(function() { toast.classList.add('is-dismissed'); }, 500);
    });

    window.addEventListener('pagehide', function() { clearTimeout(timer); }, { once: true });
  });
})();
</script>